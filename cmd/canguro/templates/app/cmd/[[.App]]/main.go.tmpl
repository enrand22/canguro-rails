// Command [[.App]] starts the [[.Title]] server.
//
// Startup order (house convention):
//
//	config → logging → database → jobs → routes → server with timeouts and a graceful shutdown
//
// Migrations are NOT applied here on purpose: they run explicitly with
// `make migrate`. A migration that fails at boot would take the service down and
// the health check would tell the proxy everything is fine.
package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"[[.Module]]/internal/config"
	"[[.Module]]/internal/routes"

	"github.com/enrand22/canguro-rails/dbx"
	"github.com/enrand22/canguro-rails/jobs"
	"github.com/enrand22/canguro-rails/logging"
)

func main() {
	if err := run(); err != nil {
		slog.Error("startup failed", "error", err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}

	// Logs go to stdout AND to a rotating file: journald is what a human reads
	// first, the file is what survives a journal vacuum.
	logger, logCloser, err := logging.New(logging.Options{
		Path:   cfg.LogFile,
		Level:  cfg.LogLevel,
		JSON:   cfg.IsProd(),
	})
	if err != nil {
		return err
	}
	if logCloser != nil {
		defer func() { _ = logCloser.Close() }()
	}
	slog.SetDefault(logger)

	// Everything cancelled here (SIGINT/SIGTERM) reaches the background work.
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	db, err := dbx.Connect(cfg.DatabaseURL)
	if err != nil {
		return err
	}
	defer db.Close()
	logger.Info("database connected")

	// Bounded background work (never a bare `go func()`): it drains on shutdown.
	pool := jobs.New(cfg.WorkerCount, logger)
	pool.Start(ctx)
	defer pool.Stop()

	app := routes.New(routes.Deps{Config: cfg, DB: db, Logger: logger})

	srv := &http.Server{
		Addr:              cfg.Addr(),
		Handler:           app,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       15 * time.Second,
		WriteTimeout:      30 * time.Second,
		IdleTimeout:       60 * time.Second,
	}

	errCh := make(chan error, 1)
	go func() {
		logger.Info("server up", "addr", cfg.Addr(), "env", cfg.Env, "workers", cfg.WorkerCount)
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			errCh <- err
		}
	}()

	select {
	case err := <-errCh:
		return err
	case <-ctx.Done():
		logger.Info("shutting down…")
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		return err
	}
	logger.Info("bye")
	return nil
}
