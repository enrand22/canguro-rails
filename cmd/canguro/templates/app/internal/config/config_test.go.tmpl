package config

import (
	"strings"
	"testing"
)

// base sets the minimum for Load() to succeed.
func base(t *testing.T) {
	t.Helper()
	t.Setenv("DATABASE_URL", "app:app@tcp(127.0.0.1:3306)/app_dev")
	t.Setenv("SESSION_SECRET", strings.Repeat("s", 40))
	t.Setenv("ENV", "development")
	t.Setenv("WORKERS", "4")
}

func TestLoadDefaults(t *testing.T) {
	base(t)
	cfg, err := Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Port != "8080" {
		t.Errorf("default port = %q, want 8080", cfg.Port)
	}
	if cfg.Addr() != ":8080" {
		t.Errorf("Addr() = %q", cfg.Addr())
	}
	if cfg.WorkerCount != 4 {
		t.Errorf("WorkerCount = %d", cfg.WorkerCount)
	}
	if cfg.IsProd() {
		t.Error("development is not production")
	}
}

func TestLoadFailsWithoutTheRequiredVariables(t *testing.T) {
	base(t)
	t.Setenv("DATABASE_URL", "")
	_, err := Load()
	if err == nil {
		t.Fatal("it should fail without DATABASE_URL")
	}
	if !strings.Contains(err.Error(), "DATABASE_URL") {
		t.Errorf("the error should name the missing variable: %v", err)
	}

	base(t)
	t.Setenv("SESSION_SECRET", "")
	if _, err := Load(); err == nil {
		t.Fatal("it should fail without SESSION_SECRET")
	}
}

func TestLoadRejectsABadWorkerCount(t *testing.T) {
	base(t)
	t.Setenv("WORKERS", "many")
	if _, err := Load(); err == nil {
		t.Fatal("a non-numeric WORKERS should fail")
	}

	base(t)
	t.Setenv("WORKERS", "0")
	if _, err := Load(); err == nil {
		t.Fatal("WORKERS=0 should fail: the pool cannot have zero workers")
	}
}

func TestProductionRequiresALongSecret(t *testing.T) {
	base(t)
	t.Setenv("ENV", "production")
	t.Setenv("SESSION_SECRET", "short")
	if _, err := Load(); err == nil {
		t.Fatal("a short secret should fail in production")
	}

	base(t)
	t.Setenv("ENV", "production")
	t.Setenv("SESSION_SECRET", strings.Repeat("x", 32))
	cfg, err := Load()
	if err != nil {
		t.Fatalf("32 characters should be enough: %v", err)
	}
	if !cfg.IsProd() {
		t.Error("IsProd should be true")
	}
}

func TestEmptyValuesFallBackToDefaults(t *testing.T) {
	base(t)
	t.Setenv("TZ", "   ")
	cfg, err := Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Timezone != "America/Tegucigalpa" {
		t.Errorf("an empty variable should fall back to the default, got %q", cfg.Timezone)
	}
}
