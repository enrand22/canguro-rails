package models

import (
	"context"
	"errors"
	"testing"

	"github.com/enrand22/canguro-rails/testsupport"
)

// storeDeTest abre la base de TESTS. Con REQUIRE_DB=1 (lo que ponen `make test` y
// CI) que falte es un FAIL, no un skip silencioso: un verde tiene que significar
// que la capa de datos se ejecutó de verdad.
func storeDeTest(t *testing.T) *Store {
	t.Helper()
	db := testsupport.DB(t)
	testsupport.HasTable(t, db, "items")
	return NewStore(db)
}

func TestCreateAndListItems(t *testing.T) {
	store := storeDeTest(t)
	ctx := context.Background()

	name := "item-de-prueba-" + t.Name()
	t.Cleanup(func() {
		_, _ = store.db.ExecContext(ctx, `DELETE FROM items WHERE name = ?`, name)
	})

	created, err := store.CreateItem(ctx, name)
	if err != nil {
		t.Fatalf("CreateItem: %v", err)
	}
	if created.ID == 0 {
		t.Error("the created item has no id")
	}

	items, err := store.ListItems(ctx, 50)
	if err != nil {
		t.Fatalf("ListItems: %v", err)
	}
	found := false
	for _, item := range items {
		if item.ID == created.ID {
			found = true
			if item.Name != name {
				t.Errorf("name = %q, want %q", item.Name, name)
			}
		}
	}
	if !found {
		t.Error("the created item is not in the list")
	}
}

func TestCreateItemReportsConflictsAsDomainErrors(t *testing.T) {
	store := storeDeTest(t)
	ctx := context.Background()

	if _, err := store.db.ExecContext(ctx, `DELETE FROM items WHERE name = ?`, "dup"); err != nil {
		t.Fatalf("cleaning: %v", err)
	}
	t.Cleanup(func() { _, _ = store.db.ExecContext(ctx, `DELETE FROM items WHERE name = ?`, "dup") })

	if _, err := store.CreateItem(ctx, "dup"); err != nil {
		t.Fatalf("first CreateItem: %v", err)
	}
	// La tabla tiene UNIQUE en name: el segundo intento tiene que llegar como error
	// del dominio (ErrConflict) y no como un error crudo del driver.
	_, err := store.CreateItem(ctx, "dup")
	if err == nil {
		t.Fatal("a duplicate should fail")
	}
	if !errors.Is(err, ErrConflict) {
		t.Errorf("a duplicate should map to ErrConflict, got: %v", err)
	}
}

func TestPingReachesTheDatabase(t *testing.T) {
	store := storeDeTest(t)
	if err := store.Ping(context.Background()); err != nil {
		t.Errorf("Ping: %v", err)
	}
}
