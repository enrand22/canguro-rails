# Build artifacts
bin/
dist/
*.exe

# Coverage
coverage.out
coverage.filtered.out
coverage.html

# Env / secrets — NEVER commit these
.env
.env.*
!.env.example
# The toolkit ships this file as a template (with the .tmpl suffix), and git would
# otherwise ignore it: the file would be missing from a fresh clone and every
# generated project would come out without .env.example.
!.env.example.tmpl

# Kamal secrets. Kamal crea `.kamal/secrets` al configurar el deploy y ahí van la
# DATABASE_URL con la password de producción, el SESSION_SECRET y los tokens de
# aviso: es el archivo más sensible del proyecto. Sin esta regla, el primer
# `git add -A` lo sube al remoto (pasó al generar canguro_site_go, y hubo que
# reescribir el historial y rotar la password de la base).
.kamal/secrets
.kamal/secrets.*

# Logs
log/
*.log

# Generated templ files ARE committed (so consumers don't need templ), but the
# tool's own cache isn't.
*_templ.txt

# Editor / OS
.idea/
.vscode/
.DS_Store
