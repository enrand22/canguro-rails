# Environment — NEVER commit the real one.
# Copy to .env and fill in. In production the supervisor injects these
# (systemd EnvironmentFile, Kamal secrets): the .env file is for development.

ENV=development
PORT=8080

# MySQL DSN (go-sql-driver). parseTime+loc are not optional: without them a
# DATETIME comes back as bytes and the timezone of your data becomes a guess.
DATABASE_URL=[[.App]]:[[.App]]@tcp(127.0.0.1:3306)/[[.App]]_dev?parseTime=true&charset=utf8mb4&loc=UTC

# 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

BASE_URL=http://localhost:8080
TZ=America/Tegucigalpa
LOG_LEVEL=info
LOG_FILE=log/[[.App]].log

# How many background jobs may run at once.
WORKERS=4

# Test database (used by `make test`). Same rules as DATABASE_URL.
TEST_DATABASE_URL=[[.App]]:[[.App]]@tcp(127.0.0.1:3307)/[[.App]]_test?parseTime=true&charset=utf8mb4&loc=UTC
